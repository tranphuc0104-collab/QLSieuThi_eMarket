@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card auth-card text-center">
            <div class="card-body p-5">
                <i class="bi bi-shield-lock text-warning display-4"></i>
                <h2 class="h4 fw-bold mt-3">Bạn không có quyền truy cập</h2>
                <p class="text-secondary">Chức năng này chỉ dành cho nhân viên quản trị.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Quay về trang phù hợp</a>
            </div>
        </div>
    </div>
</div>
