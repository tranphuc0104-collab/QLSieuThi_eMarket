@{
    ViewData["Title"] = "Tổng Quan Hệ Thống";
    var customerLookup = ViewBag.CustomerLookup as EMarket.Models.CustomerDebtLookupViewModel;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Bảng Điều Khiển Hệ Thống EMarket</h3>
        <p class="text-muted mb-0">Theo dõi và quản lý hoạt động siêu thị</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Usecase" asp-action="BanHang" class="btn btn-primary">
            <i class="bi bi-cart-check me-1"></i> Bán Hàng Nhanh
        </a>
        <a asp-controller="Usecase" asp-action="NhapHang" class="btn btn-outline-secondary">
            <i class="bi bi-box-arrow-in-down me-1"></i> Nhập Kho
        </a>
    </div>
</div>

<!-- 4 Thẻ Thống Kê Chính -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stat-card bg-primary text-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-white-50 small text-uppercase fw-semibold">Tổng đơn hàng</div>
                    <h3 class="fw-bold my-1">@ViewBag.TotalOrders</h3>
                    <small class="text-white-50"><i class="bi bi-arrow-up"></i> Ghi nhận từ hệ thống</small>
                </div>
                <div class="fs-1 text-white-50"><i class="bi bi-receipt"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-success text-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-white-50 small text-uppercase fw-semibold">Doanh số bán ra</div>
                    <h3 class="fw-bold my-1">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</h3>
                    <small class="text-white-50"><i class="bi bi-cash-stack"></i> Doanh thu tích lũy</small>
                </div>
                <div class="fs-1 text-white-50"><i class="bi bi-currency-dollar"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-warning text-dark shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-dark-50 small text-uppercase fw-semibold">Cảnh báo tồn kho</div>
                    <h3 class="fw-bold my-1">@ViewBag.WarningStock</h3>
                    <small class="text-danger fw-semibold"><i class="bi bi-exclamation-circle"></i> Vượt/Dưới định mức</small>
                </div>
                <div class="fs-1 text-dark-50"><i class="bi bi-boxes"></i></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card bg-danger text-white shadow-sm">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div class="text-white-50 small text-uppercase fw-semibold">Công nợ quá hạn</div>
                    <h3 class="fw-bold my-1">@ViewBag.DebtWarning</h3>
                    <small class="text-white-50"><i class="bi bi-alarm"></i> Cần xử lý thu hồi</small>
                </div>
                <div class="fs-1 text-white-50"><i class="bi bi-exclamation-triangle"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white">
        <h5 class="mb-0 fw-bold"><i class="bi bi-search text-primary me-2"></i>Tra cứu khách hàng và công nợ</h5>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-2 mb-3">
            <div class="col-md-9">
                <input type="search" name="keyword" value="@customerLookup?.Keyword" class="form-control"
                       placeholder="Nhập tên, mã hoặc số điện thoại khách hàng" aria-label="Tra cứu khách hàng" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i>Tra cứu
                </button>
                @if (!string.IsNullOrWhiteSpace(customerLookup?.Keyword))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Xóa</a>
                }
            </div>
        </form>

        @if (!string.IsNullOrWhiteSpace(customerLookup?.Keyword))
        {
            if (customerLookup.Customers.Count == 0)
            {
                <div class="alert alert-info mb-0">Không tìm thấy khách hàng phù hợp với “@customerLookup.Keyword”.</div>
            }
            else
            {
                <div class="d-grid gap-3">
                    @foreach (var result in customerLookup.Customers)
                    {
                        <div class="border rounded-3 p-3">
                            <div class="row g-3 align-items-start">
                                <div class="col-lg-7">
                                    <h6 class="fw-bold mb-1">@result.Customer.HoTen</h6>
                                    <div class="small text-muted">
                                        Mã KH: @result.Customer.MaKhachHang
                                        @if (!string.IsNullOrWhiteSpace(result.Customer.TenLoai))
                                        {
                                            <span class="mx-1">·</span><span>@result.Customer.TenLoai</span>
                                        }
                                    </div>
                                    <div class="small mt-2">
                                        <span class="me-3"><i class="bi bi-telephone me-1"></i>@(result.Customer.SoDienThoai ?? "Chưa có số điện thoại")</span>
                                        <span><i class="bi bi-envelope me-1"></i>@(result.Customer.Email ?? "Chưa có email")</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(result.Customer.DiaChi))
                                    {
                                        <div class="small text-muted mt-1"><i class="bi bi-geo-alt me-1"></i>@result.Customer.DiaChi</div>
                                    }
                                </div>
                                <div class="col-lg-5 text-lg-end">
                                    <div class="small text-muted">Tổng dư nợ chưa thanh toán</div>
                                    <div class="fs-5 fw-bold text-danger">@result.TotalDebt.ToString("N0") đ</div>
                                    <div class="small text-danger">Quá hạn: @result.OverdueDebt.ToString("N0") đ</div>
                                    <a asp-controller="Usecase" asp-action="CongNo" asp-route-tab="KhachHang"
                                       asp-route-maDoiTuong="@result.Customer.MaKhachHang"
                                       class="btn btn-sm btn-outline-danger mt-2">
                                        Xem công nợ chi tiết
                                    </a>
                                </div>
                            </div>

                            @if (result.Debts.Count > 0)
                            {
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Mã chứng từ</th>
                                                <th>Ngày phát sinh</th>
                                                <th>Hạn thanh toán</th>
                                                <th>Trạng thái</th>
                                                <th class="text-end">Còn nợ</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var debt in result.Debts)
                                            {
                                                var isOverdue = debt.TrangThai == "Quá hạn" ||
                                                    (debt.HanThanhToan.HasValue && debt.HanThanhToan.Value.Date < DateTime.Today);
                                                <tr>
                                                    <td><code>@debt.MaCongNo</code></td>
                                                    <td>@debt.NgayPhatSinh?.ToString("dd/MM/yyyy")</td>
                                                    <td>@debt.HanThanhToan?.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(isOverdue ? "bg-danger" : "bg-warning text-dark")">
                                                            @(isOverdue ? "Quá hạn" : "Chưa trả")
                                                        </span>
                                                    </td>
                                                    <td class="text-end fw-semibold">@debt.SoTienNo.ToString("N0") đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="small text-success mt-3"><i class="bi bi-check-circle me-1"></i>Khách hàng hiện không có công nợ chưa thanh toán.</div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

<!-- Các lối tắt tương ứng với chức năng quản lý bên trái -->
<div class="card mb-4">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Các chức năng quản lý</h5>
        <span class="badge bg-primary">EMarket</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-primary border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý sản phẩm</h6>
                        </div>
                        <p class="text-muted small">Thêm, xem và cập nhật thông tin sản phẩm.</p>
                        <a asp-controller="QuanLySanPham" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-primary border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý bán hàng</h6>
                        </div>
                        <p class="text-muted small">Lập đơn bán hàng, cập nhật tồn kho và ghi nhận doanh thu.</p>
                        <a asp-controller="Usecase" asp-action="BanHang" class="btn btn-sm btn-outline-primary w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-primary border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Thống kê - Báo cáo</h6>
                        </div>
                        <p class="text-muted small">Tổng hợp bán hàng, mặt hàng, nhà cung cấp theo ngày, tháng hoặc năm và in báo cáo.</p>
                        <a asp-controller="Usecase" asp-action="BaoCao" class="btn btn-sm btn-outline-primary w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-success border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý hóa đơn</h6>
                        </div>
                        <p class="text-muted small">Tra cứu hóa đơn, xem chi tiết và cập nhật trạng thái đơn hàng.</p>
                        <a asp-controller="Usecase" asp-action="HoaDon" class="btn btn-sm btn-outline-success w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-success border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý khách hàng</h6>
                        </div>
                        <p class="text-muted small">Thêm mới, cập nhật thông tin và chăm sóc khách hàng.</p>
                        <a asp-controller="Usecase" asp-action="KhachHang" class="btn btn-sm btn-outline-success w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-success border-opacity-25">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý điểm thưởng</h6>
                        </div>
                        <p class="text-muted small">Tra cứu điểm thành viên và quản lý đổi điểm thưởng.</p>
                        <a asp-controller="Usecase" asp-action="DiemTichLuy" class="btn btn-sm btn-outline-success w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-warning border-opacity-50">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý nhập hàng</h6>
                        </div>
                        <p class="text-muted small">Lập phiếu nhập hàng từ nhà cung cấp và cập nhật tồn kho.</p>
                        <a asp-controller="Usecase" asp-action="NhapHang" class="btn btn-sm btn-outline-warning text-dark w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-warning border-opacity-50">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý tồn kho</h6>
                        </div>
                        <p class="text-muted small">Theo dõi số lượng và cảnh báo tồn kho theo từng kho.</p>
                        <a asp-controller="Usecase" asp-action="TonKho" class="btn btn-sm btn-outline-warning text-dark w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-danger border-opacity-50">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <h6 class="fw-bold mb-0">Quản lý công nợ</h6>
                        </div>
                        <p class="text-muted small">Theo dõi công nợ Khách hàng (phải thu) & Nhà cung cấp (phải trả), cảnh báo nợ quá hạn / vượt mức.</p>
                        <a asp-controller="Usecase" asp-action="CongNo" class="btn btn-sm btn-outline-danger w-100">Mở giao diện <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
