@model EMarket.Models.ProductFormViewModel
@{
    var isEdit = ViewBag.IsEdit == true;
    var categories = ViewBag.Categories as List<EMarket.Models.DanhMuc> ?? new();
    ViewData["Title"] = isEdit ? "Sửa sản phẩm" : "Thêm sản phẩm";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Danh sách sản phẩm</a>
    <h1 class="h3 fw-bold mt-3 mb-1">@(isEdit ? "Cập nhật sản phẩm" : "Thêm sản phẩm")</h1>
    <p class="text-secondary mb-0">Ảnh được lưu trong thư mục wwwroot/images/products và đường dẫn được lưu trong cơ sở dữ liệu.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="MaSP" class="form-label"></label>
                    <input asp-for="MaSP" class="form-control" readonly="@(isEdit ? "readonly" : null)" />
                    <span asp-validation-for="MaSP" class="text-danger small"></span>
                </div>
                <div class="col-md-8">
                    <label asp-for="TenSP" class="form-label"></label>
                    <input asp-for="TenSP" class="form-control" />
                    <span asp-validation-for="TenSP" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="MaDanhMuc" class="form-label"></label>
                    <select asp-for="MaDanhMuc" class="form-select">
                        <option value="">-- Chưa phân loại --</option>
                        @foreach (var category in categories)
                        {
                            <option value="@category.MaDanhMuc">@category.TenDanhMuc</option>
                        }
                    </select>
                    <span asp-validation-for="MaDanhMuc" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="GiaBan" class="form-label"></label>
                    <input asp-for="GiaBan" class="form-control" type="number" min="0.01" step="0.01" />
                    <span asp-validation-for="GiaBan" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="DonViTinh" class="form-label"></label>
                    <input asp-for="DonViTinh" class="form-control" />
                    <span asp-validation-for="DonViTinh" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="SoLuongTon" class="form-label"></label>
                    <input asp-for="SoLuongTon" class="form-control" type="number" min="0" step="1" />
                    <div class="form-text">Số lượng tồn tổng hợp tại tất cả các kho.</div>
                    <span asp-validation-for="SoLuongTon" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="HanSuDung" class="form-label"></label>
                    <input asp-for="HanSuDung" class="form-control" type="date" />
                    <span asp-validation-for="HanSuDung" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Image" class="form-label"></label>
                    <input asp-for="Image" class="form-control" type="file" accept=".jpg,.jpeg,.png,.gif,.webp,image/jpeg,image/png,image/gif,image/webp" />
                    <div class="form-text">JPEG, PNG, GIF hoặc WebP; tối đa 5 MB. Để trống để không dùng ảnh mới.</div>
                    <span asp-validation-for="Image" class="text-danger small"></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.ExistingImage))
                {
                    <div class="col-12">
                        <div class="small text-secondary mb-2">Ảnh hiện tại</div>
                        <img src="@Model.ExistingImage" alt="Ảnh hiện tại của @Model.TenSP" class="rounded border" style="max-width: 180px; max-height: 180px; object-fit: cover;" />
                    </div>
                }
                <div class="col-12">
                    <label asp-for="MoTa" class="form-label"></label>
                    <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Lưu sản phẩm</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
            </div>
        </form>
    </div>
</div>
