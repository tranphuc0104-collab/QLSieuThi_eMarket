<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hệ Thống Quản Lý Siêu Thị EMarket</title>
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-color: #0d6efd;
            --primary-dark: #0a58ca;
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --card-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
        }
        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }
        .sidebar {
            width: 270px;
            background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
            min-height: 100vh;
            color: #cbd5e1;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            overflow-y: auto;
        }
        .sidebar .brand {
            padding: 1.25rem 1.5rem;
            font-size: 1.25rem;
            font-weight: 700;
            color: #fff;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .sidebar-section-title {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
            padding: 1rem 1.5rem 0.4rem;
            font-weight: 600;
        }
        .sidebar .nav-link {
            color: #cbd5e1;
            padding: 0.65rem 1.5rem;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            transition: all 0.2s ease;
            border-left: 3px solid transparent;
        }
        .sidebar .nav-link:hover {
            color: #ffffff;
            background-color: var(--sidebar-hover);
            border-left-color: #38bdf8;
        }
        .sidebar .nav-link.active {
            color: #ffffff;
            background-color: #0284c7;
            border-left-color: #38bdf8;
            font-weight: 600;
        }
        .main-content {
            margin-left: 270px;
            padding: 1.75rem 2.25rem;
            min-height: 100vh;
        }
        .top-navbar {
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.75rem 2.25rem;
            margin: -1.75rem -2.25rem 1.75rem -2.25rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .uc-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.6rem;
            border-radius: 9999px;
            font-weight: 600;
        }
        .card {
            border: 1px solid #e2e8f0;
            border-radius: 0.75rem;
            box-shadow: var(--card-shadow);
            background: #ffffff;
        }
        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            font-weight: 600;
            padding: 1rem 1.25rem;
        }
        .stat-card {
            border-radius: 0.75rem;
            padding: 1.25rem;
            transition: transform 0.2s;
        }
        .stat-card:hover {
            transform: translateY(-2px);
        }
        .table > :not(caption) > * > * {
            padding: 0.75rem 1rem;
        }
    </style>
</head>
<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="brand">
            <i class="bi bi-shop fs-3 text-info"></i>
            <div>
                <div>EMarket System</div>
            </div>
        </div>

        <ul class="nav flex-column mt-3">
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-grid-fill"></i><span>Tổng quan hệ thống</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "QuanLySanPham" ? "active" : "")" asp-controller="QuanLySanPham" asp-action="Index">
                        <i class="bi bi-box-seam"></i><span>Quản lý sản phẩm</span>
                    </a>
                </li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "BaoCao" ? "active" : "")" asp-controller="Usecase" asp-action="BaoCao"><i class="bi bi-bar-chart-line"></i><span>Thống kê - Báo cáo</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="BanHang"><i class="bi bi-cash-stack"></i><span>Quản lý bán hàng</span></a></li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "HoaDon" ? "active" : "")" asp-controller="Usecase" asp-action="HoaDon"><i class="bi bi-receipt"></i><span>Quản lý hóa đơn</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="KhachHang"><i class="bi bi-people-fill"></i><span>Quản lý khách hàng</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="DiemTichLuy"><i class="bi bi-award-fill"></i><span>Quản lý điểm thưởng</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="NhapHang"><i class="bi bi-box-arrow-in-down"></i><span>Quản lý nhập hàng</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="TonKho"><i class="bi bi-boxes"></i><span>Quản lý tồn kho</span></a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Usecase" asp-action="CongNo"><i class="bi bi-journal-text"></i><span>Quản lý công nợ</span></a></li>
            }
            else
            {
                <div class="sidebar-section-title">MUA SẮM</div>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "TraCuuHangHoa" ? "active" : "")" asp-controller="Usecase" asp-action="TraCuuHangHoa"><i class="bi bi-search"></i><span>Tra cứu hàng hóa</span></a></li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "DatHang" ? "active" : "")" asp-controller="Usecase" asp-action="DatHang"><i class="bi bi-cart-plus-fill"></i><span>Đặt hàng trực tuyến</span></a></li>
                <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "TheoDoiDonHang" ? "active" : "")" asp-controller="Usecase" asp-action="TheoDoiDonHang"><i class="bi bi-clock-history"></i><span>Theo dõi đơn hàng</span></a></li>
            }
        </ul>

        <div class="p-3 mt-4 text-center border-top border-secondary">
            <small class="text-white-50">@(User.IsInRole("Admin") ? "Khu vực nhân viên" : "Khu vực khách hàng")</small>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        <!-- Top Navbar -->
        <div class="top-navbar">
            <div class="d-flex align-items-center gap-2">
                <span class="text-secondary">Dự án:</span>
                <strong class="text-primary">PHẦN MỀM QUẢN LÝ SIÊU THỊ EMARKET</strong>
            </div>
            <div class="d-flex align-items-center gap-3">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="badge bg-info bg-opacity-10 text-info border border-info">
                        <i class="bi bi-person-circle me-1"></i> @(User.IsInRole("Admin") ? "Nhân viên" : "Khách hàng")
                    </span>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                        <button class="btn btn-sm btn-outline-secondary" type="submit">Đăng xuất</button>
                    </form>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="CuaHang" asp-action="Index" class="btn btn-sm btn-outline-success">
                            <i class="bi bi-shop me-1"></i>Về website
                        </a>
                    }
                }
                else
                {
                    <a asp-controller="CuaHang" asp-action="Index" class="btn btn-sm btn-outline-success">Về website</a>
                    <a asp-controller="Auth" asp-action="Login" class="btn btn-sm btn-outline-primary">Đăng nhập</a>
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-sm btn-primary">Đăng ký</a>
                }
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
