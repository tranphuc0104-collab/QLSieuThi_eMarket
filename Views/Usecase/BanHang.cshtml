@{
    ViewData["Title"] = "Quản Lý Bán Hàng";
    var khachHangs = ViewBag.KhachHangs as List<EMarket.Models.KhachHang>;
    var sanPhams = ViewBag.SanPhams as List<EMarket.Models.SanPham>;
    var recentOrders = ViewBag.RecentOrders as List<EMarket.Models.DonHang>;
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;
    var selectedProductId = ViewBag.SelectedProductId as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-success mb-1">Quản lý bán hàng</span>
        <h3 class="fw-bold mb-0">Bán Hàng Tại Quầy (POS)</h3>
        <p class="text-muted small">Lập hóa đơn nhiều sản phẩm, cập nhật tồn kho và tích điểm thành viên.</p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <a asp-action="HoaDon" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i>Quản lý hóa đơn</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>@success</div>
}
@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i>@error</div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calculator me-2 text-success"></i>Lập hóa đơn bán hàng</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="LapDonBanHang" id="posForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="selectKhachHang">Khách hàng</label>
                        <select name="maKhachHang" id="selectKhachHang" class="form-select" required>
                            <option value="">-- Chọn khách hàng --</option>
                            @if (khachHangs != null)
                            {
                                foreach (var kh in khachHangs)
                                {
                                    <option value="@kh.MaKhachHang" data-loai="@kh.MaLoai">@kh.HoTen - @kh.SoDienThoai (@kh.TenLoai)</option>
                                }
                            }
                        </select>
                        <div id="customerPolicyAlert" class="mt-2 text-primary small fw-semibold" style="display:none;"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <label class="form-label fw-semibold mb-0">Sản phẩm trong hóa đơn</label>
                        <button type="button" class="btn btn-sm btn-outline-success" id="addProduct">
                            <i class="bi bi-plus-circle me-1"></i>Thêm sản phẩm
                        </button>
                    </div>
                    <div id="productRows">
                        <div class="row g-2 align-items-end product-row mb-3">
                            <div class="col-md-5">
                                <label class="form-label small">Sản phẩm</label>
                                <select name="maSP[0]" class="form-select product-select" required>
                                    <option value="">-- Chọn sản phẩm --</option>
                                    @if (sanPhams != null)
                                    {
                                        foreach (var sp in sanPhams)
                                        {
                                            <option value="@sp.MaSP" selected="@(selectedProductId == sp.MaSP ? "selected" : null)" data-base-price="@sp.GiaBan" data-stock="@sp.SoLuongTon" data-unit="@sp.DonViTinh">
                                                @sp.TenSP (Tồn: @sp.SoLuongTon @sp.DonViTinh) - @sp.GiaBan.ToString("N0") đ
                                            </option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small">Số lượng</label>
                                <input type="number" name="soLuong[0]" class="form-control product-qty" min="1" value="1" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small">Đơn giá (VNĐ)</label>
                                <input type="number" name="giaApDung[0]" class="form-control product-price" min="1" step="1" required />
                            </div>
                            <div class="col-md-2 d-flex align-items-center justify-content-between">
                                <span class="small fw-semibold text-success line-total">0 đ</span>
                                <button type="button" class="btn btn-sm btn-outline-danger remove-product" aria-label="Xóa sản phẩm" title="Xóa sản phẩm" disabled>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 border d-flex justify-content-between align-items-center">
                        <span class="fs-5 fw-bold">TỔNG TIỀN PHẢI THU:</span>
                        <span class="fs-4 fw-bold text-success" id="posTotal">0 đ</span>
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
                        <i class="bi bi-printer-fill me-1"></i>Lập hóa đơn
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-receipt me-1 text-success"></i>Hóa đơn vừa bán</h6>
                <a asp-action="HoaDon" class="small">Xem tất cả</a>
            </div>
            <div class="list-group list-group-flush">
                @if (recentOrders?.Any() == true)
                {
                    foreach (var order in recentOrders)
                    {
                        <a asp-action="HoaDon" asp-route-maDonHang="@order.MaDonHang" class="list-group-item list-group-item-action">
                            <div class="d-flex justify-content-between">
                                <strong class="text-primary">@order.MaDonHang</strong>
                                <span class="text-success fw-bold">@order.TongTien.ToString("N0") đ</span>
                            </div>
                            <div class="small text-muted">@order.TenKhachHang - @order.NgayDat?.ToString("dd/MM/yyyy HH:mm")</div>
                        </a>
                    }
                }
                else
                {
                    <div class="p-3 text-muted small">Chưa có hóa đơn nào.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const productRows = document.getElementById("productRows");
    const customerSelect = document.getElementById("selectKhachHang");
    const policyAlert = document.getElementById("customerPolicyAlert");

    function currentDiscount() {
        const type = customerSelect.options[customerSelect.selectedIndex]?.dataset.loai;
        if (type === "LKH03") return 0.10;
        if (type === "LKH02") return 0.05;
        return 0;
    }

    function reindexRows() {
        const rows = [...productRows.querySelectorAll(".product-row")];
        rows.forEach((row, index) => {
            row.querySelector(".product-select").name = `maSP[${index}]`;
            row.querySelector(".product-qty").name = `soLuong[${index}]`;
            row.querySelector(".product-price").name = `giaApDung[${index}]`;
            row.querySelector(".remove-product").disabled = rows.length === 1;
        });
        updateSelectedProducts();
    }

    function updateSelectedProducts() {
        const selects = [...productRows.querySelectorAll(".product-select")];
        const selected = selects.map(select => select.value).filter(Boolean);
        selects.forEach(select => {
            [...select.options].forEach(option => {
                option.disabled = option.value !== "" && selected.includes(option.value) && select.value !== option.value;
            });
        });
    }

    function updateTotals() {
        let total = 0;
        const discount = currentDiscount();
        productRows.querySelectorAll(".product-row").forEach(row => {
            const select = row.querySelector(".product-select");
            const option = select.options[select.selectedIndex];
            const qtyInput = row.querySelector(".product-qty");
            const priceInput = row.querySelector(".product-price");
            const basePrice = Number(option.dataset.basePrice) || 0;
            const suggestedPrice = Math.round(basePrice * (1 - discount));

            if (!select.value) {
                priceInput.value = "";
                delete priceInput.dataset.manual;
            } else if (!priceInput.dataset.manual) {
                priceInput.value = suggestedPrice;
            }

            const qty = Number(qtyInput.value) || 0;
            const price = Number(priceInput.value) || 0;
            const lineTotal = qty * price;
            total += lineTotal;
            row.querySelector(".line-total").textContent = lineTotal.toLocaleString("vi-VN") + " đ";
        });
        document.getElementById("posTotal").textContent = total.toLocaleString("vi-VN") + " đ";
    }

    customerSelect.addEventListener("change", () => {
        const type = customerSelect.options[customerSelect.selectedIndex]?.dataset.loai;
        if (type === "LKH03") {
            policyAlert.textContent = "Khách hàng VIP: giảm 10% trên giá niêm yết.";
            policyAlert.style.display = "block";
        } else if (type === "LKH02") {
            policyAlert.textContent = "Khách hàng thân thiết: giảm 5% trên giá niêm yết.";
            policyAlert.style.display = "block";
        } else {
            policyAlert.style.display = "none";
        }
        updateTotals();
    });

    document.getElementById("addProduct").addEventListener("click", () => {
        const row = productRows.querySelector(".product-row").cloneNode(true);
        row.querySelector(".product-select").value = "";
        row.querySelector(".product-qty").value = "1";
        row.querySelector(".product-price").value = "";
        delete row.querySelector(".product-price").dataset.manual;
        row.querySelector(".line-total").textContent = "0 đ";
        productRows.appendChild(row);
        reindexRows();
        updateTotals();
    });

    productRows.addEventListener("click", event => {
        const removeButton = event.target.closest(".remove-product");
        if (removeButton && productRows.querySelectorAll(".product-row").length > 1) {
            removeButton.closest(".product-row").remove();
            reindexRows();
            updateTotals();
        }
    });

    productRows.addEventListener("change", event => {
        if (event.target.matches(".product-select")) {
            const priceInput = event.target.closest(".product-row").querySelector(".product-price");
            delete priceInput.dataset.manual;
            updateSelectedProducts();
            updateTotals();
        }
    });
    productRows.addEventListener("input", event => {
        if (event.target.matches(".product-price")) {
            event.target.dataset.manual = "true";
        }
        updateTotals();
    });
    reindexRows();
    updateTotals();
</script>
}
