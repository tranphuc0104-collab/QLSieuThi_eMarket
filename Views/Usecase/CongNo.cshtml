@model List<EMarket.Models.CongNo>
@{
    ViewData["Title"] = "Quản Lý Công Nợ";
    var tab = ViewBag.CurrentTab as string ?? "KhachHang";
    var khachHangs = ViewBag.KhachHangs as List<EMarket.Models.KhachHang>;
    var nccs = ViewBag.NhaCungCaps as List<EMarket.Models.NhaCungCap>;
    var selectedDoiTuong = ViewBag.SelectedDoiTuong as string;
    var selectedTrangThai = ViewBag.SelectedTrangThai as string;
    var tongNo = ViewBag.TongNo as decimal? ?? 0;
    var soQuaHan = ViewBag.SoChungTuQuaHan as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Quản Lý Công Nợ Theo Chứng Từ</h3>
        <p class="text-muted small">Kiểm tra & theo dõi công nợ Khách Hàng (Khoản phải thu) và Nhà Cung Cấp (Khoản phải trả), cảnh báo nợ quá hạn hoặc quá hạn mức.</p>
    </div>
    <div>
        <span class="badge bg-light text-dark border p-2">
            <i class="bi bi-person-workspace text-danger me-1"></i> Nhân viên công nợ: <strong>Nguyễn Văn Hải (NV05)</strong>
        </span>
    </div>
</div>

<!-- Tabs Chuyển Đổi: Khách Hàng (Phải Thu) vs Nhà Cung Cấp (Phải Trả) -->
<ul class="nav nav-tabs mb-4">
    <li class="nav-item">
        <a class="nav-link fw-bold @(tab == "KhachHang" ? "active text-danger border-danger border-bottom-0" : "text-muted")"
           asp-action="CongNo" asp-route-tab="KhachHang">
            <i class="bi bi-people me-1"></i> Công Nợ Khách Hàng (Phải Thu)
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link fw-bold @(tab == "NhaCungCap" ? "active text-danger border-danger border-bottom-0" : "text-muted")"
           asp-action="CongNo" asp-route-tab="NhaCungCap">
            <i class="bi bi-truck me-1"></i> Công Nợ Nhà Cung Cấp (Phải Trả)
        </a>
    </li>
</ul>

<!-- Thống kê nhanh tổng dư nợ & cảnh báo -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card bg-white border">
            <span class="text-muted small text-uppercase fw-semibold">Tổng Dư Nợ Theo Chứng Từ</span>
            <h3 class="fw-bold my-1 text-danger">@tongNo.ToString("N0") VNĐ</h3>
            <small class="text-muted">Tổng số tiền đang nợ</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white border border-danger">
            <span class="text-danger small text-uppercase fw-bold"><i class="bi bi-alarm-fill me-1"></i> Số Chứng Từ Quá Hạn</span>
            <h3 class="fw-bold my-1 text-danger">@soQuaHan chứng từ</h3>
            <small class="text-danger">Cần gửi thông báo nhắc nợ ngay</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card bg-white border border-warning">
            <span class="text-warning-emphasis small text-uppercase fw-bold"><i class="bi bi-shield-exclamation me-1"></i> Cảnh Báo Định Mức</span>
            <h3 class="fw-bold my-1 text-warning-emphasis">Hạn mức tối đa: 50.000.000 đ</h3>
            <small class="text-muted">Cảnh báo nếu vượt quá quy định</small>
        </div>
    </div>
</div>

<!-- Bộ lọc đối tượng & trạng thái -->
<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="CongNo" class="row g-3 align-items-center">
            <input type="hidden" name="tab" value="@tab" />
            <div class="col-md-5">
                <label class="form-label small fw-semibold">Chọn đối tượng cần kiểm tra:</label>
                <select name="maDoiTuong" class="form-select">
                    <option value="">-- Tất cả @(tab == "KhachHang" ? "Khách Hàng" : "Nhà Cung Cấp") --</option>
                    @if (tab == "KhachHang" && khachHangs != null)
                    {
                        foreach (var kh in khachHangs)
                        {
                            <option value="@kh.MaKhachHang" selected="@(selectedDoiTuong == kh.MaKhachHang ? "selected" : null)">
                                @kh.MaKhachHang - @kh.HoTen
                            </option>
                        }
                    }
                    else if (tab == "NhaCungCap" && nccs != null)
                    {
                        foreach (var n in nccs)
                        {
                            <option value="@n.MaNCC" selected="@(selectedDoiTuong == n.MaNCC ? "selected" : null)">
                                @n.MaNCC - @n.TenNCC
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">Tình trạng chứng từ:</label>
                <select name="trangThai" class="form-select">
                    <option value="">-- Tất cả tình trạng --</option>
                    <option value="Chưa trả" selected="@(selectedTrangThai == "Chưa trả" ? "selected" : null)">Chưa trả</option>
                    <option value="Quá hạn" selected="@(selectedTrangThai == "Quá hạn" ? "selected" : null)">Quá hạn thanh toán</option>
                    <option value="Đã thanh toán" selected="@(selectedTrangThai == "Đã thanh toán" ? "selected" : null)">Đã thanh toán tất toán</option>
                </select>
            </div>
            <div class="col-md-3 align-self-end">
                <button type="submit" class="btn btn-danger w-100 fw-bold">
                    <i class="bi bi-filter me-1"></i> Lọc Chứng Từ
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Bảng Danh Sách Công Nợ -->
<div class="card shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold">
            <i class="bi bi-journal-text text-danger me-2"></i>Bảng Kê Công Nợ Chi Tiết Theo Từng Chứng Từ
        </h5>
        <span class="badge bg-secondary">Nhân viên quản lý: NV05</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã Chứng Từ</th>
                        <th>Đối Tượng</th>
                        <th>Loại Công Nợ</th>
                        <th>Ngày Phát Sinh</th>
                        <th>Hạn Thanh Toán</th>
                        <th class="text-end">Số Tiền Nợ (VNĐ)</th>
                        <th class="text-center">Cảnh Báo Hệ Thống</th>
                        <th class="text-center">Thao Tác Thu/Trả</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var cn in Model)
                        {
                            var isOverdue = cn.SoTienNo > 0 && cn.TrangThai != "Đã thanh toán" &&
                                (cn.TrangThai == "Quá hạn" || (cn.HanThanhToan.HasValue && cn.HanThanhToan.Value.Date < DateTime.Today));
                            var isOverLimit = cn.SoTienNo > 50000000;
                            <tr>
                                <td><code>@cn.MaCongNo</code></td>
                                <td>
                                    <strong>@cn.DoiTuongTen</strong><br />
                                    <small class="text-muted">Mã: @(tab == "KhachHang" ? cn.MaKhachHang : cn.MaNCC)</small>
                                    @if (!string.IsNullOrWhiteSpace(cn.MaDonHang))
                                    {
                                        <br /><small class="text-primary">Đơn hàng: @cn.MaDonHang</small>
                                    }
                                </td>
                                <td><span class="badge bg-light text-dark border">@cn.LoaiCongNo</span></td>
                                <td>@cn.NgayPhatSinh?.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (isOverdue)
                                    {
                                        <span class="text-danger fw-bold"><i class="bi bi-clock-history me-1"></i>@cn.HanThanhToan?.ToString("dd/MM/yyyy")</span>
                                    }
                                    else
                                    {
                                        <span>@cn.HanThanhToan?.ToString("dd/MM/yyyy")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <span class="fw-bold fs-6 text-danger">@cn.SoTienNo.ToString("N0") đ</span>
                                </td>
                                <td class="text-center">
                                    @if (isOverdue)
                                    {
                                        <span class="badge bg-danger p-2" title="Quá hạn thanh toán theo quy định">
                                            <i class="bi bi-exclamation-triangle-fill me-1"></i> Cảnh báo: Quá thời gian quy định
                                        </span>
                                    }
                                    else if (isOverLimit)
                                    {
                                        <span class="badge bg-warning text-dark p-2" title="Nợ vượt hạn mức 50 triệu">
                                            <i class="bi bi-shield-fill-exclamation me-1"></i> Cảnh báo: Nợ quá mức cho phép
                                        </span>
                                    }
                                    else if (cn.SoTienNo == 0)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success p-2">
                                            <i class="bi bi-check-circle-fill me-1"></i> Đã tất toán
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info p-2">
                                            <i class="bi bi-shield-check me-1"></i> Không có vi phạm
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (cn.SoTienNo > 0)
                                    {
                                        <button class="btn btn-sm btn-outline-success" onclick="openPaymentModal('@cn.MaCongNo', '@cn.DoiTuongTen', @cn.SoTienNo)">
                                            <i class="bi bi-cash-coin me-1"></i> @(tab == "KhachHang" ? "Thu tiền" : "Trả nợ")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Hoàn tất</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Không tìm thấy thông tin công nợ phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Thanh Toán / Thu Tiền Công Nợ -->
<div class="modal fade" id="modalThanhToan" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CapNhatCongNo" method="post">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-cash-stack me-2 text-success"></i>Cập Nhật Thanh Toán Công Nợ</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="payMaCongNo" name="maCongNo" />
                    <div class="mb-3">
                        <label class="form-label text-muted small">Mã chứng từ:</label>
                        <input type="text" id="payDisplayMa" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Đối tượng:</label>
                        <input type="text" id="payDoiTuong" class="form-control bg-light" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small">Số dư nợ hiện tại:</label>
                        <input type="text" id="paySoTienNo" class="form-control bg-light text-danger fw-bold" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Số tiền thanh toán đợt này (VNĐ): <span class="text-danger">*</span></label>
                        <input type="number" id="payInputSoTien" name="soTienThanhToan" class="form-control form-control-lg" required min="1000" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-success fw-bold">Xác Nhận Thanh Toán</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openPaymentModal(ma, ten, no) {
        document.getElementById("payMaCongNo").value = ma;
        document.getElementById("payDisplayMa").value = ma;
        document.getElementById("payDoiTuong").value = ten;
        document.getElementById("paySoTienNo").value = no.toLocaleString('vi-VN') + " đ";
        document.getElementById("payInputSoTien").max = no;
        document.getElementById("payInputSoTien").value = no;

        const modal = new bootstrap.Modal(document.getElementById("modalThanhToan"));
        modal.show();
    }
</script>
}
