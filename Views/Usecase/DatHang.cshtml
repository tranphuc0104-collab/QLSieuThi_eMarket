@{
    ViewData["Title"] = "Đặt Hàng Trực Tuyến";
    var khachHangs = ViewBag.KhachHangs as List<EMarket.Models.KhachHang>;
    var sanPhams = ViewBag.SanPhams as List<EMarket.Models.SanPham>;
    var success = ViewBag.Success as string;
    var error = ViewBag.Error as string;
    var newOrder = ViewBag.NewOrder as EMarket.Models.DonHang;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h3 class="fw-bold mb-0">Đặt Hàng Trực Tuyến</h3>
        <p class="text-muted small">Khách hàng chọn sản phẩm, nhập số lượng, kiểm tra tồn kho tự động và xác nhận đặt hàng.</p>
    </div>
</div>

@if (!string.IsNullOrEmpty(success))
{
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-check-circle-fill fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">Đặt Hàng Thành Công!</h5>
            <div>@success</div>
            @if (newOrder != null)
            {
                <a asp-action="TheoDoiDonHang" asp-route-maDonHang="@newOrder.MaDonHang" class="btn btn-sm btn-success mt-2">
                    <i class="bi bi-eye me-1"></i> Theo dõi tiến độ đơn hàng ngay
                </a>
            }
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(error))
{
    <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-3 me-3"></i>
        <div>
            <h5 class="alert-heading fw-bold mb-1">Không thể tạo đơn hàng</h5>
            <div>@error</div>
        </div>
    </div>
}

<div class="row">
    <!-- Form Đặt hàng -->
    <div class="col-md-7">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0 fw-bold"><i class="bi bi-cart-plus me-2 text-primary"></i>Biểu Mẫu Thông Tin Đặt Hàng</h5>
            </div>
            <div class="card-body p-4">
                <form method="post" asp-action="DatHang" id="formOrder">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Người đặt hàng</label>
                        @if (khachHangs?.FirstOrDefault() is EMarket.Models.KhachHang kh)
                        {
                            <input type="hidden" name="maKhachHang" value="@kh.MaKhachHang" />
                            <div class="form-control bg-light">@kh.HoTen · @kh.SoDienThoai</div>
                            <small class="text-muted">Đơn hàng sẽ được gắn với tài khoản đang đăng nhập.</small>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">Không tìm thấy hồ sơ khách hàng cho tài khoản này.</div>
                        }
                    </div>

                    <!-- Chọn sản phẩm -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">2. Chọn Hàng Hóa cần mua: <span class="text-danger">*</span></label>
                        <select name="maSP" id="selectSP" class="form-select" required onchange="updateProductInfo()">
                            <option value="" data-price="0" data-stock="0" data-unit="">-- Vui lòng chọn sản phẩm --</option>
                            @if (sanPhams != null)
                            {
                                foreach (var sp in sanPhams)
                                {
                                    <option value="@sp.MaSP" data-price="@sp.GiaBan" data-stock="@sp.SoLuongTon" data-unit="@sp.DonViTinh">
                                        @sp.TenSP - Giá: @sp.GiaBan.ToString("N0") đ / @sp.DonViTinh (Còn lại trong kho: @sp.SoLuongTon)
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row">
                        <!-- Số lượng -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">3. Số lượng mua: <span class="text-danger">*</span></label>
                            <input type="number" id="inputQuantity" name="soLuong" class="form-control" min="1" value="1" required oninput="calcTotal()" />
                            <div id="stockHint" class="form-text text-muted">Tồn kho hiện có: -</div>
                        </div>

                        <!-- Đơn giá niêm yết -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Đơn giá niêm yết:</label>
                            <input type="text" id="displayPrice" class="form-control bg-light" readonly value="0 đ" />
                        </div>
                    </div>

                    <!-- Ghi chú đơn hàng -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold">4. Địa chỉ & Ghi chú giao hàng:</label>
                        <textarea name="ghiChu" rows="2" class="form-control" placeholder="Giao trong giờ hành chính, gọi trước khi giao..."></textarea>
                    </div>

                    <!-- Tổng thanh toán dự kiến -->
                    <div class="p-3 bg-light rounded-3 mb-3 border">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fs-6 fw-bold">Tổng thanh toán dự kiến:</span>
                            <span class="fs-4 fw-bold text-danger" id="totalPreview">0 đ</span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                        <i class="bi bi-bag-check-fill me-1"></i> Xác Nhận Đặt Hàng
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Danh sách sản phẩm gợi ý / tra cứu nhanh -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <h6 class="mb-0 fw-bold"><i class="bi bi-box-seam me-1 text-primary"></i>Danh mục hàng hóa sẵn có</h6>
                <span class="badge bg-info">Kho EMarket</span>
            </div>
            <div class="card-body p-0">
                <div class="list-group list-group-flush">
                    @if (sanPhams != null)
                    {
                        foreach (var item in sanPhams)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold">@item.TenSP</div>
                                    <small class="text-muted">ĐVT: @item.DonViTinh | HSD: @(item.HanSuDung?.ToString("dd/MM/yyyy") ?? "N/A")</small>
                                </div>
                                <div class="text-end">
                                    <div class="text-danger fw-bold">@item.GiaBan.ToString("N0") đ</div>
                                    <small class="badge @(item.SoLuongTon > 10 ? "bg-success" : "bg-danger")">Kho: @item.SoLuongTon</small>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentPrice = 0;
    let currentStock = 0;

    function updateProductInfo() {
        const select = document.getElementById("selectSP");
        const selected = select.options[select.selectedIndex];
        currentPrice = parseFloat(selected.getAttribute("data-price")) || 0;
        currentStock = parseInt(selected.getAttribute("data-stock")) || 0;
        const unit = selected.getAttribute("data-unit") || "";

        document.getElementById("displayPrice").value = currentPrice.toLocaleString('vi-VN') + " đ / " + unit;
        document.getElementById("stockHint").innerText = "Tồn kho hiện có: " + currentStock + " " + unit;
        calcTotal();
    }

    function calcTotal() {
        const qty = parseInt(document.getElementById("inputQuantity").value) || 0;
        const total = qty * currentPrice;
        document.getElementById("totalPreview").innerText = total.toLocaleString('vi-VN') + " đ";
    }
</script>
}
