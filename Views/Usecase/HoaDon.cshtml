@model List<EMarket.Models.DonHang>
@{
    ViewData["Title"] = "Quản Lý Hóa Đơn";
    var selectedOrder = ViewBag.SelectedOrder as EMarket.Models.DonHang;
    var searchCode = ViewBag.SearchCode as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <span class="badge bg-success mb-1">Bán hàng</span>
        <h3 class="fw-bold mb-0">Quản Lý Hóa Đơn</h3>
        <p class="text-muted small">Tra cứu hóa đơn, xem chi tiết và cập nhật trạng thái đơn hàng.</p>
    </div>
    <a asp-action="BanHang" class="btn btn-success"><i class="bi bi-plus-circle me-1"></i>Lập hóa đơn</a>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header bg-white">
                <form method="get" asp-action="HoaDon" class="row g-2">
                    <div class="col">
                        <input type="search" name="maDonHang" value="@searchCode" class="form-control" placeholder="Tìm theo mã hóa đơn" />
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
                        <a asp-action="HoaDon" class="btn btn-outline-secondary">Tất cả</a>
                    </div>
                </form>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã hóa đơn</th>
                            <th>Khách hàng</th>
                            <th>Ngày lập</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Tổng tiền</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var order in Model)
                            {
                                var statusBadgeClass = order.TrangThai switch
                                {
                                    "Đã hoàn tất" or "Đã giao" or "Đã nhận" => "bg-success",
                                    "Đang giao" => "bg-info text-dark",
                                    "Đang chuẩn bị" => "bg-primary",
                                    "Đang xử lý" or "Chờ xác nhận" => "bg-warning text-dark",
                                    "Đã hủy" or "Đã hủy đơn" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                <tr class="@(selectedOrder?.MaDonHang == order.MaDonHang ? "table-primary" : "")">
                                    <td><code>@order.MaDonHang</code></td>
                                    <td>@order.TenKhachHang</td>
                                    <td>@order.NgayDat?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td><span class="badge @statusBadgeClass">@order.TrangThai</span></td>
                                    <td class="text-end fw-semibold">@order.TongTien.ToString("N0") đ</td>
                                    <td class="text-end">
                                        <a asp-action="HoaDon" asp-route-maDonHang="@order.MaDonHang" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">Không tìm thấy hóa đơn.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        @if (selectedOrder != null)
        {
            var subtotal = selectedOrder.ChiTiet.Sum(line => line.ThanhTien);
            var nextStatus = selectedOrder.TrangThai switch
            {
                "Đang xử lý" => "Đang chuẩn bị",
                "Đang chuẩn bị" => "Đang giao",
                "Đang giao" => "Đã hoàn tất",
                _ => null
            };
            var selectedStatusBadgeClass = selectedOrder.TrangThai switch
            {
                "Đã hoàn tất" or "Đã giao" or "Đã nhận" => "bg-success",
                "Đang giao" => "bg-info text-dark",
                "Đang chuẩn bị" => "bg-primary",
                "Đang xử lý" or "Chờ xác nhận" => "bg-warning text-dark",
                "Đã hủy" or "Đã hủy đơn" => "bg-danger",
                _ => "bg-secondary"
            };
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="fw-bold">Chi tiết hóa đơn</div>
                    <small>@selectedOrder.MaDonHang · @selectedOrder.NgayDat?.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <div class="card-body">
                    <div class="small mb-3">
                        <div><strong>Khách hàng:</strong> @selectedOrder.TenKhachHang</div>
                        <div><strong>Số điện thoại:</strong> @selectedOrder.SoDienThoai</div>
                        @if (!string.IsNullOrWhiteSpace(selectedOrder.DiaChiGiaoHang))
                        {
                            <div><strong>Địa chỉ giao:</strong> @selectedOrder.DiaChiGiaoHang</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedOrder.PhuongThucThanhToan))
                        {
                            <div><strong>Thanh toán:</strong> @selectedOrder.PhuongThucThanhToan</div>
                        }
                    </div>
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3 p-3 bg-light rounded">
                        <div>
                            <strong>Trạng thái đơn hàng:</strong>
                            <span class="badge @selectedStatusBadgeClass ms-1">@selectedOrder.TrangThai</span>
                        </div>
                        @if (nextStatus != null)
                        {
                            <form method="post" asp-action="CapNhatTrangThaiDonHang" class="m-0">
                                <input type="hidden" name="maDonHang" value="@selectedOrder.MaDonHang" />
                                <input type="hidden" name="trangThaiMoi" value="@nextStatus" />
                                <button type="submit" class="btn btn-sm btn-success">
                                    @if (selectedOrder.TrangThai == "Đang xử lý")
                                    {
                                        <i class="bi bi-box-seam me-1"></i><span>Xác nhận & chuẩn bị hàng</span>
                                    }
                                    else if (selectedOrder.TrangThai == "Đang chuẩn bị")
                                    {
                                        <i class="bi bi-truck me-1"></i><span>Bàn giao vận chuyển</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-1"></i><span>Xác nhận hoàn tất</span>
                                    }
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Đơn hàng đã hoàn tất</span>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center">SL</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-end">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedOrder.ChiTiet)
                                {
                                    <tr>
                                        <td>@line.TenSP <div class="text-muted small">@line.MaSP</div></td>
                                        <td class="text-center">@line.SoLuong @line.DonViTinh</td>
                                        <td class="text-end">@line.DonGia.ToString("N0") đ</td>
                                        <td class="text-end">@line.ThanhTien.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Tổng tiền sản phẩm</th>
                                    <th class="text-end">@subtotal.ToString("N0") đ</th>
                                </tr>
                                @if (selectedOrder.TienGiamGia > 0)
                                {
                                    <tr>
                                        <th colspan="3" class="text-end text-success">Voucher @(selectedOrder.MaVoucher ?? "")</th>
                                        <th class="text-end text-success">-@selectedOrder.TienGiamGia.ToString("N0") đ</th>
                                    </tr>
                                }
                                <tr>
                                    <th colspan="3" class="text-end">Khách phải trả</th>
                                    <th class="text-end text-success">@selectedOrder.TongTien.ToString("N0") đ</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(searchCode))
        {
            <div class="alert alert-warning">Không tìm thấy hóa đơn có mã “@searchCode”.</div>
        }
        else
        {
            <div class="card h-100">
                <div class="card-body d-flex align-items-center justify-content-center text-muted text-center">
                    Chọn một hóa đơn trong danh sách để xem các sản phẩm và chi tiết thanh toán.
                </div>
            </div>
        }
    </div>
</div>
