@model List<EMarket.Models.DonHang>
@{
    ViewData["Title"] = "Xử lý đơn hàng";
    var selectedStatus = ViewBag.SelectedStatus as string;
    var searchCode = ViewBag.SearchCode as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <span class="badge bg-success mb-1">Nhân viên bán hàng</span>
        <h1 class="h3 fw-bold mb-1">Xử lý đơn hàng</h1>
        <p class="text-muted mb-0">Kiểm tra sản phẩm, thông tin giao nhận và cập nhật tiến độ đơn hàng.</p>
    </div>
    <a asp-action="HoaDon" class="btn btn-outline-primary"><i class="bi bi-receipt me-1"></i>Quản lý hóa đơn</a>
</div>

<div class="card mb-4">
    <div class="card-body">
        <form method="get" asp-action="XuLyDonHang" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label for="orderSearch" class="form-label">Mã đơn hàng</label>
                <input id="orderSearch" name="maDonHang" value="@searchCode" class="form-control" placeholder="Nhập mã đơn cần tìm" />
            </div>
            <div class="col-md-4">
                <label for="statusFilter" class="form-label">Trạng thái</label>
                <select id="statusFilter" name="trangThai" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    @foreach (var status in new[] { "Đang xử lý", "Đang chuẩn bị", "Đang giao", "Đã hoàn tất" })
                    {
                        <option value="@status" selected="@(selectedStatus == status ? "selected" : null)">@status</option>
                    }
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-search me-1"></i>Lọc</button>
                <a asp-action="XuLyDonHang" class="btn btn-outline-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="card">
        <div class="card-body py-5 text-center text-muted">
            <i class="bi bi-inbox display-5 d-block mb-2"></i>
            Không có đơn hàng phù hợp.
        </div>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @for (var index = 0; index < Model.Count; index++)
        {
            var order = Model[index];
            var detailId = $"order-detail-{index}";
            var recipientName = string.IsNullOrWhiteSpace(order.TenNguoiNhan) ? order.TenKhachHang : order.TenNguoiNhan;
            var subtotal = order.ChiTiet.Sum(line => line.ThanhTien);
            var nextStatus = order.TrangThai switch
            {
                "Đang xử lý" => "Đang chuẩn bị",
                "Đang chuẩn bị" => "Đang giao",
                "Đang giao" => "Đã hoàn tất",
                _ => null
            };
            var badgeClass = order.TrangThai switch
            {
                "Đã hoàn tất" => "bg-success",
                "Đang giao" => "bg-info text-dark",
                "Đang chuẩn bị" => "bg-primary",
                _ => "bg-warning text-dark"
            };

            <article class="card shadow-sm">
                <div class="card-body">
                    <div class="d-flex flex-wrap justify-content-between gap-3">
                        <div>
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                <span class="fw-bold text-primary">@order.MaDonHang</span>
                                <span class="badge @badgeClass">@order.TrangThai</span>
                            </div>
                            <div class="fw-semibold">@recipientName</div>
                            <div class="small text-muted">@order.SoDienThoai · @order.NgayDat?.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="text-md-end">
                            <div class="small text-muted">@(order.ChiTiet.Count) mặt hàng</div>
                            <div class="fs-5 fw-bold text-success">@order.TongTien.ToString("N0") đ</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3 pt-3 border-top">
                        <button class="btn btn-sm btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#@detailId" aria-expanded="false" aria-controls="@detailId">
                            <i class="bi bi-eye me-1"></i>Chi tiết giao hàng & sản phẩm
                        </button>
                        @if (nextStatus != null)
                        {
                            <form method="post" asp-action="CapNhatTrangThaiDonHang" class="m-0">
                                <input type="hidden" name="maDonHang" value="@order.MaDonHang" />
                                <input type="hidden" name="trangThaiMoi" value="@nextStatus" />
                                <button type="submit" class="btn btn-success">
                                    @if (order.TrangThai == "Đang xử lý")
                                    {
                                        <i class="bi bi-box-seam me-1"></i><span>Xác nhận & chuẩn bị hàng</span>
                                    }
                                    else if (order.TrangThai == "Đang chuẩn bị")
                                    {
                                        <i class="bi bi-truck me-1"></i><span>Bàn giao vận chuyển</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-check-circle me-1"></i><span>Xác nhận hoàn tất</span>
                                    }
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-success fw-semibold"><i class="bi bi-check-circle-fill me-1"></i>Đơn hàng đã hoàn tất</span>
                        }
                    </div>
                    <div class="collapse mt-3" id="@detailId">
                        <div class="rounded-3 bg-light p-3">
                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <div class="small text-muted">ĐỊA CHỈ GIAO HÀNG</div>
                                    <div class="fw-semibold">@(order.DiaChiGiaoHang ?? "Chưa có thông tin")</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="small text-muted">PHƯƠNG THỨC THANH TOÁN</div>
                                    <div class="fw-semibold">@(order.PhuongThucThanhToan ?? "Chưa có thông tin")</div>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-sm table-bordered bg-white align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th class="text-center">Số lượng</th>
                                            <th class="text-end">Đơn giá</th>
                                            <th class="text-end">Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var line in order.ChiTiet)
                                        {
                                            <tr>
                                                <td>@line.TenSP <small class="text-muted">(@line.MaSP)</small></td>
                                                <td class="text-center">@line.SoLuong @line.DonViTinh</td>
                                                <td class="text-end">@line.DonGia.ToString("N0") đ</td>
                                                <td class="text-end">@line.ThanhTien.ToString("N0") đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-end">Tổng tiền sản phẩm</th>
                                            <th class="text-end">@subtotal.ToString("N0") đ</th>
                                        </tr>
                                        @if (order.TienGiamGia > 0)
                                        {
                                            <tr>
                                                <th colspan="3" class="text-end text-success">Voucher @(order.MaVoucher ?? "")</th>
                                                <th class="text-end text-success">-@order.TienGiamGia.ToString("N0") đ</th>
                                            </tr>
                                        }
                                        <tr>
                                            <th colspan="3" class="text-end">Khách phải trả</th>
                                            <th class="text-end fw-bold">@order.TongTien.ToString("N0") đ</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
}
